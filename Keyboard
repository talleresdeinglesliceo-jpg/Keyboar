local function isProtected(obj)
	local name = obj.Name:lower()
	if name:find("muzzle") or name:find("flash") or name:find("gun") or name:find("weapon") or name:find("arma") or name:find("disparo") or name:find("bullet") or name:find("bala") or name:find("proyectil") or name:find("hitbox") or name:find("tracer") or name:find("trazadora") or name:find("beam") or name:find("trail") or name:find("effect") or name:find("efecto") or name:find("fire") or name:find("light") then
		return true
	end
	local ancestor = obj.Parent
	while ancestor do
		local aname = ancestor.Name:lower()
		if aname:find("character") or aname:find("player") or aname:find("weapon") or aname:find("gun") or aname:find("arma") or Players:GetPlayerFromCharacter(ancestor) then
			return true
		end
		ancestor = ancestor.Parent
	end
	return false
end

local function optimize(obj)
	pcall(function()
		if isProtected(obj) then return end

		if obj:IsA("BasePart") then
			local name = obj.Name:lower()
			if name:find("pumpkin") or name:find("calabaza") or name:find("leaf") or name:find("leaves") or name:find("hoja") or name:find("bundle") then
				obj:Destroy()
				return
			end
			
			obj.Material = Enum.Material.SmoothPlastic
			obj.Reflectance = 0
			
			if obj:IsA("MeshPart") then
				obj.RenderFidelity = Enum.RenderFidelity.Performance
			end
			
		elseif obj:IsA("Light") then
			obj.Enabled = false
		elseif obj:IsA("Texture") or obj:IsA("Decal") then
			obj.Transparency = 1
		elseif obj:IsA("ParticleEmitter") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") or obj:IsA("Beam") or obj:IsA("Trail") then
			obj.Enabled = false
		end
	end)
end

for _, v in ipairs(Workspace:GetDescendants()) do
	optimize(v)
end

Workspace.DescendantAdded:Connect(function(v)
	optimize(v)
end)

