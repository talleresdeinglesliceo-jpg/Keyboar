	local tweenInfo = TweenInfo.new(0.05, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)

	local function setKeyState(keyName, isActive)
		local data = keyElements[keyName]
		if not data or data.Active == isActive then return end
		data.Active = isActive

		if isActive then
			data.Frame.BackgroundColor3 = data.Accent
			data.Frame.BackgroundTransparency = 0.1
			data.Label.TextColor3 = COLOR_TEXT_ACTIVE
		else
			data.Frame.BackgroundColor3 = COLOR_BG_IDLE
			data.Frame.BackgroundTransparency = 0.25
			data.Label.TextColor3 = COLOR_TEXT_IDLE
		end
	end

	local function makeDraggable(guiObject)
		local dragging, dragStart, startPos

		guiObject.InputBegan:Connect(function(input)
			if isLocked then return end
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragging = true
				dragStart = input.Position
				startPos = guiObject.Position
			end
		end)

		UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
				local delta = input.Position - dragStart
				guiObject.Position = UDim2.new(
					startPos.X.Scale, startPos.X.Offset + delta.X,
					startPos.Y.Scale, startPos.Y.Offset + delta.Y
				)
			end
		end)

		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragging = false
			end
		end)
	end

