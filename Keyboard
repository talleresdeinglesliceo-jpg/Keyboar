createKey("S", UDim2.new(0, 39, 0, 78), stdSize, COLORS["S"])
createKey("D", UDim2.new(0, 78, 0, 78), stdSize, COLORS["D"])

-- Fila de salto: SPACE
createKey("SPACE", UDim2.new(0, 0, 0, 117), spaceSize, COLORS["SPACE"], "SPACE")

-- ==========================================
-- DIBUJO DEL MINI MOUSE A LA DERECHA (Solo botón izquierdo / LMB)
-- ==========================================
createKey("LMB", UDim2.new(0, 117, 0, 39), UDim2.new(0, 34, 0, 112), COLORS["LMB"], "L1")

-- Animación al presionar/soltar
local tweenInfo = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function setKeyState(keyName, isActive)
	local data = keyElements[keyName]
	if not data or data.Active == isActive then return end
	data.Active = isActive

	if isActive then
		TweenService:Create(data.Frame, tweenInfo, {
			BackgroundColor3 = data.Accent,
			BackgroundTransparency = 0.1
		}):Play()
		data.Label.TextColor3 = COLOR_TEXT_ACTIVE
	else
		TweenService:Create(data.Frame, tweenInfo, {
			BackgroundColor3 = COLOR_BG_IDLE,
			BackgroundTransparency = 0.25
		}):Play()
		data.Label.TextColor3 = COLOR_TEXT_IDLE
	end
end

-- Detección del toque en pantalla (Móvil) o Clic izquierdo (PC)
local isTouchingScreen = false

UserInputService.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
		isTouchingScreen = true
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
		isTouchingScreen = false
	end
end)

-- Arrastrar el teclado en pantalla si estorba
local dragging, dragInput, dragStart, startPos
mainFrame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = mainFrame.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

mainFrame.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - dragStart
		mainFrame.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y
		)
	end
end)

-- Lazo de actualización en tiempo real
RunService.RenderStepped:Connect(function()
	local char = player.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")

	-- 1. Joystick
	if humanoid and humanoid.MoveDirection.Magnitude > 0.1 then
		local relativeMove = camera.CFrame:VectorToObjectSpace(humanoid.MoveDirection)
		setKeyState("W", relativeMove.Z < -0.35)
		setKeyState("S", relativeMove.Z > 0.35)
		setKeyState("A", relativeMove.X < -0.35)
		setKeyState("D", relativeMove.X > 0.35)
	else
		setKeyState("W", false)
		setKeyState("S", false)
		setKeyState("A", false)
		setKeyState("D", false)
	end

	-- 2. Salto (SPACE)
	local isJumping = (humanoid and humanoid.Jump) or UserInputService:IsKeyDown(Enum.KeyCode.Space)
	setKeyState("SPACE", isJumping)

	-- 3. Mini Mouse (LMB se activa al tocar la pantalla)
	setKeyState("LMB", isTouchingScreen or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1))

	-- 4. Armas 1 a 4
	local backpack = player:FindFirstChild("Backpack")
	local tools = {}
	
	if backpack then
		for _, item in ipairs(backpack:GetChildren()) do
			if item:IsA("Tool") then
				table.insert(tools, item)
			end
		end
	end
	
	local equippedTool = char and char:FindFirstChildOfClass("Tool")
	if equippedTool then
		table.insert(tools, equippedTool)
	end

	table.sort(tools, function(a, b) return a.Name < b.Name end)

	for i = 1, 4 do
		local slotTool = tools[i]
		if slotTool and slotTool.Parent == char then
			setKeyState(tostring(i), true)
		else
			setKeyState(tostring(i), false)
		end
	end
end)
