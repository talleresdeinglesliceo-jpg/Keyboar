local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local camera = workspace.CurrentCamera

-- Eliminar GUI anterior si se vuelve a ejecutar
if playerGui:FindFirstChild("VisualKeystrokesMVS") then
	playerGui.VisualKeystrokesMVS:Destroy()
end

-- Creación de la interfaz principal
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "VisualKeystrokesMVS"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.Parent = playerGui

-- Contenedor en la ESQUINA SUPERIOR DERECHA
local mainFrame = Instance.new("Frame")
mainFrame.Name = "Container"
mainFrame.Size = UDim2.new(0, 191, 0, 153)
mainFrame.Position = UDim2.new(1, -207, 0, 16)
mainFrame.BackgroundTransparency = 1
mainFrame.Parent = screenGui

-- Colores
local COLOR_BG_IDLE = Color3.fromRGB(22, 22, 26)
local COLOR_BG_ACTIVE = Color3.fromRGB(255, 255, 255)
local COLOR_TEXT_IDLE = Color3.fromRGB(255, 255, 255)
local COLOR_TEXT_ACTIVE = Color3.fromRGB(15, 15, 15)

-- Paleta de colores
local COLORS = {
	["1"]     = Color3.fromRGB(170, 85, 255),  -- Morado
	["2"]     = Color3.fromRGB(255, 65, 140),  -- Rosa/Magenta
	["3"]     = Color3.fromRGB(255, 150, 45),  -- Naranja
	["4"]     = Color3.fromRGB(255, 220, 50),  -- Amarillo
	["W"]     = Color3.fromRGB(70, 235, 110),  -- Verde
	["A"]     = Color3.fromRGB(45, 210, 255),  -- Cian
	["S"]     = Color3.fromRGB(55, 165, 255),  -- Azul claro
	["D"]     = Color3.fromRGB(85, 115, 255),  -- Azul/Índigo
	["SPACE"] = Color3.fromRGB(255, 185, 45),  -- Dorado
	["LMB"]   = Color3.fromRGB(255, 80, 80)    -- Rojo (Clic Izquierdo / Táctil)
}

local keyElements = {}

-- Función para construir cada tecla o sección del mouse
local function createKey(name, pos, size, accentColor, customText)
	local keyFrame = Instance.new("Frame")
	keyFrame.Name = "Key_" .. name
	keyFrame.Size = size or UDim2.new(0, 34, 0, 34)
	keyFrame.Position = pos
	keyFrame.BackgroundColor3 = COLOR_BG_IDLE
	keyFrame.BackgroundTransparency = 0.25
	keyFrame.BorderSizePixel = 0
	keyFrame.Parent = mainFrame

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = keyFrame

	local stroke = Instance.new("UIStroke")
	stroke.Color = accentColor
	stroke.Thickness = 1.6
	stroke.Transparency = 0.15
	stroke.Parent = keyFrame

	-- Barra de acento inferior
	local bottomBar = Instance.new("Frame")
	bottomBar.Name = "AccentBar"
	bottomBar.Size = UDim2.new(0.65, 0, 0, 2)
	bottomBar.Position = UDim2.new(0.175, 0, 1, -5)
	bottomBar.BackgroundColor3 = accentColor
	bottomBar.BorderSizePixel = 0
	bottomBar.Parent = keyFrame

	local barCorner = Instance.new("UICorner")
	barCorner.CornerRadius = UDim.new(1, 0)
	barCorner.Parent = bottomBar

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.new(1, 0, 1, -2)
	label.BackgroundTransparency = 1
	label.Text = customText or name
	label.Font = Enum.Font.GothamBold
	label.TextSize = 12
	label.TextColor3 = COLOR_TEXT_IDLE
	label.Parent = keyFrame

	keyElements[name] = {
		Frame = keyFrame,
		Label = label,
		Accent = accentColor,
		Active = false
	}
end

local stdSize = UDim2.new(0, 34, 0, 34)
local spaceSize = UDim2.new(0, 112, 0, 34)

-- Fila superior: 1, 2, 3, 4
createKey("1", UDim2.new(0, 0, 0, 0), stdSize, COLORS["1"])
createKey("2", UDim2.new(0, 39, 0, 0), stdSize, COLORS["2"])
